MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=local
MYSQL_PASSWORD=replace-with-your-password
MYSQL_DATABASE=q_balance

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=Q-Balance <noreply@example.com>

# Optional shared demo account for the "Try the demo account" button.
# Leave both empty to hide the button. Guests can always browse the read-only showcase data.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=replace-with-a-long-random-password
